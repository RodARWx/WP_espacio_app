# ==============================================================================
# ESPACIO Local Infrastructure Environment Variables (Template)
# Copy this file to .env and fill in secure local values. Never commit .env!
# ==============================================================================

# MySQL 8.4 (Relational DB)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=espacio_db
MYSQL_USER=espacio_user
MYSQL_PASSWORD=change_me_mysql_password

# MongoDB 7.0 (Document DB)
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=espacio_mongo
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_password
MONGO_DATABASE=espacio_docs

# Redis 7.2 (Cache & TimeSlot Locks)
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# Qdrant (Vector DB for Embeddings / RAG)
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Keycloak 26 (OIDC / PKCE IAM)
KEYCLOAK_PORT=8443
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_password

# n8n (Workflow Automation)
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=change_me_n8n_password
N8N_ENCRYPTION_KEY=change_me_32_char_encryption_key
